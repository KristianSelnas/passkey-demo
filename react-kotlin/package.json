{
  "name": "passkey-demo",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta --kill-others-on-fail \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && ./mvnw spring-boot:run",
    "dev:frontend": "npm --prefix frontend run dev",
    "postinstall": "npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
